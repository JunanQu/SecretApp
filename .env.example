# Postgres connection string (local dev or Neon in production)
DATABASE_URL="postgresql://user@localhost:5432/secretapp"

# Google AI Studio API key for the AI message writer (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Brevo API key + verified sender for "they answered" email notifications (https://brevo.com)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# Comma-separated access codes allowed to create invites (empty = open access)
ACCESS_CODES=""

# Public origin used for links inside emails, e.g. "https://secretapp-rust.vercel.app".
# Set this in any environment that sends mail: without it the link is built from
# request headers, which a caller can spoof.
APP_BASE_URL=""
