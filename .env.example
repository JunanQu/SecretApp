# Postgres connection string (local dev or Neon in production)
DATABASE_URL="postgresql://user@localhost:5432/secretapp"

# Google AI Studio API key for the AI message writer (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Resend API key for "they answered" email notifications (https://resend.com)
RESEND_API_KEY=""

# Comma-separated access codes allowed to create invites (empty = open access)
ACCESS_CODES=""
