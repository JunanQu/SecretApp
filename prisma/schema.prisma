generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Invite {
  id           String     @id @default(cuid())
  slug         String     @unique
  secret       String     @unique
  fromName     String
  toName       String
  message      String
  theme        String     @default("blush")
  notifyEmail  String?
  /// where the invite link was emailed, and when it last went out
  toEmail      String?
  inviteSentAt DateTime?
  location     String?
  timezone     String?
  dateOptions  Json
  createdAt    DateTime   @default(now())
  responses    Response[]
}

model Response {
  id                String   @id @default(cuid())
  inviteId          String
  invite            Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  accepted          Boolean
  selectedOptionIds Json
  proposedTimes     Json     @default("[]")
  note              String?
  createdAt         DateTime @default(now())
}
